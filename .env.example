# Telegram bot token — get one from @BotFather
TELEGRAM_BOT_TOKEN=your_token_here

# Master admin chat ID — only this account can use admin commands.
# Find your chat ID by messaging @userinfobot on Telegram.
ADMIN_CHAT_ID=your_chat_id_here

# Optional: comma-separated list of chat IDs approved at startup.
# Additional users can be approved at runtime via /approve.
ALLOWED_CHAT_IDS=your_chat_id_here

# ── Google Sheets integration (optional) ───────────────────────────────────
# Set GOOGLE_ENABLED=true to start appending transcripts to a Google Sheet.
# See README for how to create a service account and share the sheet with it.
GOOGLE_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/your-service-account.json
GOOGLE_SHEET_NAME=Voice Transcripts

# ── HuggingFace (optional) ─────────────────────────────────────────────────
# Silences unauthenticated-request warnings when the Whisper model is downloaded.
# Free read-only token at https://huggingface.co/settings/tokens
HF_TOKEN=
